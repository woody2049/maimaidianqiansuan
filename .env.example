# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不要提交真实密钥。
# 注意：server.js 为保持零依赖不解析 .env 文件，请用环境变量方式注入：
#   set -a && source .env && set +a && node app/server.js

# 麦当劳 MCP Token（从麦当劳开放平台控制台申请）。
# 留空时应用仍可运行：使用示例菜单与示例门店，只是不能查真实门店价格。
MCD_TOKEN=your_mcd_mcp_token_here

# 可选：MCP 网关地址
MCD_ENDPOINT=https://mcp.mcd.cn

# 可选：服务端口
PORT=3000

# ---- 以下全部可选：不填则整站走「本机保存」，不显示登录入口 ----
CLOUD_ENDPOINT=
CLOUD_RESOURCE_ID=
CLOUD_OAUTH_RELAY_URL=
CLOUD_PUBLISHABLE_KEY=
